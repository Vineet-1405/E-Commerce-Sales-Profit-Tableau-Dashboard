      <aliases enabled="yes"/>
      <column caption="Order Count " datatype="integer" name="[Calculation_1263379943350273]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([Order ID])"/>
      </column>
      <column caption="Profit Per Order" datatype="real" name="[Calculation_1263379943862274]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Profit])/COUNTD([Order ID])"/>
      </column>
      <column caption="Profit Status " datatype="string" name="[Calculation_1263379944566787]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF SUM([Profit]) &gt;= 0 THEN&#13;&#10;    &quot;Profitable&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Loss&quot;&#13;&#10;END"/>
      </column>
      <column datatype="string" name="[City]" role="dimension" semantic-role="[City].[Name]" type="nominal"/>
      <column datatype="string" name="[Country]" role="dimension" semantic-role="[Country].[ISO3166_2]" type="nominal"/>
      <column datatype="integer" name="[Order Year]" role="dimension" type="quantitative"/>
      <column caption="Overall Profit Margin " datatype="real" name="[Profit Margin (copy)_1263379949580292]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([Sales]) = 0 THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    SUM([Profit]) / SUM([Sales])&#13;&#10;END"/>
      </column>
      <column datatype="string" name="[State]" role="dimension" semantic-role="[State].[Name]" type="nominal"/>
